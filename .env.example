# Modèle des variables d'environnement de Spotly.
# Copier ce fichier en .env, puis adapter les valeurs. Le fichier .env n'est jamais versionné.

# --- Base de données (utilisée par docker-compose.yml) ---
POSTGRES_USER=spotly
POSTGRES_PASSWORD=spotly_dev
POSTGRES_DB=spotly
POSTGRES_PORT=5432

# --- Connexion de l'API à la base (utilisée par Prisma) ---
DATABASE_URL=postgresql://spotly:spotly_dev@localhost:5432/spotly
