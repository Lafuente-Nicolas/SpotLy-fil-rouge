@startuml sequence-creer-spot
' Diagramme de séquence : créer un spot (US-07)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign left
skinparam ParticipantBorderColor #0F4C5C
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ActorBorderColor #0F4C5C
skinparam ArrowColor #1E1E1E
autonumber

actor "Utilisateur" as U
participant "Frontend\n(React)" as F
participant "API\n(Express)" as A
participant "Cloudinary" as C
database "PostgreSQL" as B

U -> F : remplit le formulaire\net ajoute 1 à 5 photos
F -> F : vérifie les champs et les photos (Zod)
F -> A : POST /api/spots (formulaire multipart)\n+ cookie de session
A -> B : retrouve la session
B --> A : utilisateur connecté

alt session absente ou expirée
  A --> F : 401 Non connecté
  F --> U : redirige vers la connexion
else utilisateur connecté
  A -> A : valide les données (Zod)\net les photos (nombre, type, poids)
  alt données invalides
    A --> F : 400 + erreurs champ par champ
    F --> U : affiche chaque erreur\nà côté du champ
  else données valides
    loop pour chaque photo
      A -> C : envoie la photo
      C --> A : url + identifiant_media
    end
    A -> B : transaction : INSERT spot (statut PUBLIE),\nphotos et tags
    alt erreur d'enregistrement
      B --> A : erreur
      A -> C : supprime les photos déjà envoyées
      A --> F : 500 Erreur d'enregistrement
      F --> U : affiche un message d'erreur
    else enregistrement réussi
      B --> A : spot créé
      A --> F : 201 + spot créé
      F --> U : affiche le spot sur la carte
    end
  end
end
@enduml
